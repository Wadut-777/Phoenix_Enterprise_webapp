# Copy to .env and fill in. Never commit .env.

# Public domain (used by nginx, Let's Encrypt and sitemap/canonical URLs)
DOMAIN=example.com
SITE_URL=https://example.com
LETSENCRYPT_EMAIL=admin@example.com

# MongoDB
MONGO_ROOT_USER=phoenix_root
MONGO_ROOT_PASSWORD=change-me-long-random
MONGO_DB=phoenix
# Used by the backend container (host "mongo" is the compose service)
MONGODB_URI=mongodb://phoenix_root:change-me-long-random@mongo:27017/phoenix?authSource=admin

# Backend
NODE_ENV=production
PORT=5000
# Comma separated list of allowed browser origins (only needed if API is on another origin)
CORS_ORIGINS=https://example.com
UPLOAD_DIR=/data/uploads
# Reserved for the CMS phase (JWT auth)
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-another-64-random-chars
